# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-prod
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── SMTP (optional) ────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@crm.example.com

# ─── S3 / Object Storage (optional) ─────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=crm-storage
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# ─── Observability (optional) ───────────────────────────
SENTRY_DSN=
